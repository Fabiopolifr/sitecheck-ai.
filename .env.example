# Database — PostgreSQL connection string (self-managed, e.g. on a
# Hostinger VPS, or any other Postgres provider). Without it the app falls
# back to an in-memory store (see AI/DECISIONS.md). If your server has no
# TLS listener (typical for a self-managed instance on the same VPS or a
# private network), omit sslmode; add `?sslmode=require` only if the
# server actually terminates TLS.
DATABASE_URL=postgres://user:password@localhost:5432/sitecheck_ai

# AI provider (provider-agnostic layer, see AI/ARCHITECTURE.md)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Performance
PAGESPEED_API_KEY=

# Email
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Affiliate
COOKIEYES_AFFILIATE_URL=

# Admin (single-admin MVP password gate — see AI/DECISIONS.md)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# App
APP_URL=http://localhost:3000

# Content engine (Phase 5) — shared secret for the external scheduler
# calling POST /api/content/generate. Generate with e.g. `openssl rand -hex 32`.
CONTENT_GENERATION_SECRET=

# Outreach (AI/DECISIONS.md D37) — Google Places API key for lead
# discovery, plus the shared secret the external scheduler sends in the
# x-outreach-secret header to POST /api/outreach/run.
GOOGLE_PLACES_API_KEY=
OUTREACH_SECRET=

# Absolute path of the Phusion Passenger restart file, used by the
# "Riavvia il sito" button in /admin (AI/DECISIONS.md D45). On Hostinger
# it must go through the `current` symlink, e.g.
# /home/<user>/domains/<domain>/hbuilds/current/nodejs/tmp/restart.txt
# Leave empty outside Hostinger — the button is only useful there.
PASSENGER_RESTART_FILE=

# Secret del webhook Resend (whsec_...) per bounce e segnalazioni spam.
# Si ottiene creando il webhook nella dashboard Resend, puntandolo a
# https://<dominio>/api/webhooks/resend con gli eventi email.bounced e
# email.complained. Senza questo l'endpoint risponde 404.
# Vedi AI/DECISIONS.md D53.
RESEND_WEBHOOK_SECRET=

# Secret del webhook Resend (whsec_...) per bounce e segnalazioni spam.
# Si ottiene creando il webhook nella dashboard Resend, puntandolo a
# https://<dominio>/api/webhooks/resend. Senza questo valore
# l'endpoint risponde 404. Vedi AI/DECISIONS.md D53.
RESEND_WEBHOOK_SECRET=
